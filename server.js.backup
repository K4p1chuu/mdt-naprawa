// ----------------------------------------------------------------
// POST /api/discord/citizen-data - Przyjmuje dowód osobisty
// ----------------------------------------------------------------
app.post('/api/discord/citizen-data', (req, res) => {
    try {
        const data = req.body;
        
        // Walidacja
        if (!data.discordId || !data.firstName || !data.lastName) {
            return res.status(400).json({ 
                success: false, 
                message: 'Brak wymaganych pól: discordId, firstName, lastName' 
            });
        }
        
        // NOWE: Dezaktywuj wszystkie stare dowody tego użytkownika
        let deactivatedCount = 0;
        Object.values(discordCitizens).forEach(citizen => {
            if (citizen.discordId === data.discordId && citizen.approved) {
                citizen.approved = false;
                citizen.deactivated = true;
                citizen.deactivatedAt = new Date().toISOString();
                citizen.deactivatedReason = 'Nowy dowód - stary zdezaktywowany automatycznie';
                deactivatedCount++;
            }
        });
        
        if (deactivatedCount > 0) {
            console.log(`[DISCORD] Zdezaktywowano ${deactivatedCount} starych dowodów użytkownika ${data.discordTag}`);
        }
        
        // Dodaj timestamp i ID
        const citizenId = data.messageId || `CITIZEN_${Date.now()}`;
        
        const citizenData = {
            id: citizenId,
            discordId: data.discordId,
            discordTag: data.discordTag,
            firstName: data.firstName,
            lastName: data.lastName,
            age: data.age,
            dateOfBirth: data.dateOfBirth,
            countryOfOrigin: data.countryOfOrigin,
            cityOfOrigin: data.cityOfOrigin,
            history: data.history,
            gender: data.gender,
            robloxNick: data.robloxNick,
            approved: false,
            submittedAt: data.submittedAt || new Date().toISOString(),
            lastEditDate: null,
            deactivated: false
        };
        
        // Zapisz
        discordCitizens[citizenId] = citizenData;
        saveData(DB.discord_citizens, discordCitizens);
        
        console.log(`[DISCORD] Dodano dowód osobisty: ${data.firstName} ${data.lastName} (${data.discordTag})`);
        
        res.json({ success: true, citizenId, data: citizenData });
        
    } catch (error) {
        console.error('[DISCORD] Błąd przyjmowania dowodu:', error);
        res.status(500).json({ success: false, message: 'Internal server error' });
    }
});

