app.get('/api/officers/records/:email', verifyToken, (req, res) => {
    const email = decodeURIComponent(req.params.email);
    const officer = users[email];
    
    if (!officer) {
        return res.status(404).json({ success: false, message: 'Nie znaleziono funkcjonariusza' });
    }
    
    const allRecords = Object.values(records).flat();
    const officerRecords = allRecords.filter(r => r.author === officer.username);
    officerRecords.sort((a, b) => new Date(b.issueDate) - new Date(a.issueDate));
    
    res.json(officerRecords);
});

// ENDPOINT: Usuwanie rekordów
app.delete('/api/records/:civilianId/:recordId', verifyToken, verifySenior, (req, res) => {
    const { civilianId, recordId } = req.params;
    
    if (!records[civilianId]) {
        return res.status(404).json({ success: false, message: 'Nie znaleziono rekordów dla tego obywatela' });
    }
    
    const recordIndex = records[civilianId].findIndex(r => r.id === recordId);
    if (recordIndex === -1) {
        return res.status(404).json({ success: false, message: 'Nie znaleziono rekordu o podanym ID' });
    }
    
    const deletedRecord = records[civilianId][recordIndex];
    records[civilianId].splice(recordIndex, 1);
    
    if (records[civilianId].length === 0) {
        delete records[civilianId];
    }
    
    if (citizens[civilianId]) {
        if (deletedRecord.reportType === 'mandat') {
            citizens[civilianId].ticketCount = Math.max(0, (citizens[civilianId].ticketCount || 0) - 1);
        } else if (deletedRecord.reportType === 'areszt') {
            citizens[civilianId].arrestCount = Math.max(0, (citizens[civilianId].arrestCount || 0) - 1);
        } else if (deletedRecord.reportType === 'pouczenie') {
            citizens[civilianId].warningCount = Math.max(0, (citizens[civilianId].warningCount || 0) - 1);
        }
        saveData(DB.citizens, citizens);
    }
    
    saveData(DB.records, records);
    res.json({ success: true, message: 'Rekord został usunięty' });
});

