// ================================================================
// DODANO: Endpoint logów akcji dla Chief Of the Police i Superintendent
app.get('/api/audit-logs', verifyToken, (req, res) => {
    // Sprawdź czy użytkownik ma uprawnienia (Chief lub Superintendent z odznaką 101/00)
    const hasAccess = req.user.badge === '101' || 
                      req.user.badge === '00' || 
                      req.user.rank === 'Chief Of the Police' ||
                      req.user.rank === 'Superintendent';
    
    if (!hasAccess) {
        return res.status(403).json({ 
            success: false, 
            message: 'Brak uprawnień. Dostęp tylko dla Chief Of the Police (00) i Superintendent (101).' 
        });
    }
    
    // Paginacja (opcjonalna)
    const page = parseInt(req.query.page) || 1;
    const limit = parseInt(req.query.limit) || 50;
    const startIndex = (page - 1) * limit;
    const endIndex = page * limit;
    
    // Filtrowanie (opcjonalne)
    let filteredLogs = auditLogs;
    
    if (req.query.section) {
        filteredLogs = filteredLogs.filter(log => log.section === req.query.section);
    }
    
    if (req.query.officerBadge) {
        filteredLogs = filteredLogs.filter(log => log.officerBadge === req.query.officerBadge);
    }
    
    if (req.query.date) {
        filteredLogs = filteredLogs.filter(log => log.date === req.query.date);
    }
    
    // Zwróć odpowiedź z paginacją
    const paginatedLogs = filteredLogs.slice(startIndex, endIndex);
    
    res.json({
        success: true,
        logs: paginatedLogs,
        pagination: {
            total: filteredLogs.length,
            page: page,
            limit: limit,
            totalPages: Math.ceil(filteredLogs.length / limit)
        }
    });
});

