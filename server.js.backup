app.put('/api/officers/:email', verifyToken, verifyAdmin, (req, res) => {
    const email = decodeURIComponent(req.params.email);
    if (!users[email]) return res.status(404).json({ success: false, message: 'Nie znaleziono oficera' });
    
    const { username, badge, rank, department, password, robloxId, discordNick, robloxNick } = req.body;
    if (username) users[email].username = username;
    if (badge) users[email].badge = badge;
    if (rank) users[email].rank = rank;
    if (department) users[email].department = department;
    if (password) users[email].password = password;
    if (robloxId) users[email].robloxId = robloxId;
    if (discordNick) users[email].discordNick = discordNick;
    if (robloxNick) users[email].robloxNick = robloxNick;
    
    saveData(DB.users, users);
    res.json({ success: true, officer: users[email] });
});

app.delete('/api/officers/:email', verifyToken, verifyAdmin, (req, res) => {
    const email = decodeURIComponent(req.params.email);
    if (!users[email]) return res.status(404).json({ success: false, message: 'Nie znaleziono oficera' });
    if (email === req.user.email) return res.status(403).json({ success: false, message: 'Nie możesz usunąć samego siebie' });
    
    delete users[email];
    saveData(DB.users, users);
    res.json({ success: true, message: 'Oficer został usunięty' });
});

// ================================================================
// ENDPOINTY DLA DIAGNOSTÓW (CEPIK)
// ================================================================

app.get('/api/diagnosticians', verifyToken, (req, res) => {
    res.json(diagnosticians);
});

app.post('/api/diagnosticians', verifyToken, verifyAdminOrCEPiKManager, (req, res) => {
    const { email, password, discordNick, robloxNick, skpNumber } = req.body;
    
    if (diagnosticians.find(d => d.email === email)) {
        return res.status(400).json({ success: false, message: 'Diagnosta o tym emailu już istnieje' });
    }
    
    const newDiagnostician = {
        id: crypto.randomUUID(),
        email,
        password,
        discordNick: discordNick || email.split('@')[0],
        robloxNick: robloxNick || '',
        skpNumber: skpNumber || 'WA-000',
        isDiagnostician: true,
        token: null
    };
    
    diagnosticians.push(newDiagnostician);
    saveData(DB.diagnosticians, diagnosticians);
    res.json({ success: true, diagnostician: newDiagnostician });
});

app.put('/api/diagnosticians/:email', verifyToken, verifyAdmin, (req, res) => {
    const email = decodeURIComponent(req.params.email);
    const index = diagnosticians.findIndex(d => d.email === email);
    
    if (index === -1) return res.status(404).json({ success: false, message: 'Nie znaleziono diagosty' });
    
    const { password, discordNick, robloxNick, skpNumber } = req.body;
    if (password) diagnosticians[index].password = password;
    if (discordNick) diagnosticians[index].discordNick = discordNick;
    if (robloxNick) diagnosticians[index].robloxNick = robloxNick;
    if (skpNumber) diagnosticians[index].skpNumber = skpNumber;
    
    saveData(DB.diagnosticians, diagnosticians);
    res.json({ success: true, diagnostician: diagnosticians[index] });
});

app.delete('/api/diagnosticians/:email', verifyToken, verifyAdminOrCEPiKManager, (req, res) => {
    const email = decodeURIComponent(req.params.email);
    const index = diagnosticians.findIndex(d => d.email === email);
    
    if (index === -1) return res.status(404).json({ success: false, message: 'Nie znaleziono diagosty' });
    
    diagnosticians.splice(index, 1);
    saveData(DB.diagnosticians, diagnosticians);
    res.json({ success: true, message: 'Diagnosta został usunięty' });
});


