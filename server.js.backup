// ----------------------------------------------------------------
// PUT /api/discord/approve/:type/:id - Zatwierdza entry
// ----------------------------------------------------------------
app.put('/api/discord/approve/:type/:id', (req, res) => {
    try {
        const { type, id } = req.params;
        
        let found = false;
        let data = null;
        
        // Znajdź i zatwierdź
        if (type === 'citizen') {
            // Szukaj po messageId
            const entry = Object.values(discordCitizens).find(c => c.messageId === id || c.id === id);
            if (entry) {
                entry.approved = true;
                entry.approvedAt = new Date().toISOString();
                saveData(DB.discord_citizens, discordCitizens);
                found = true;
                data = entry;
                console.log(`[DISCORD] Zatwierdzono dowód: ${entry.firstName} ${entry.lastName}`);
            }
        } else if (type === 'vehicle') {
            const entry = Object.values(discordVehicles).find(v => v.messageId === id || v.id === id);
            if (entry) {
                entry.approved = true;
                entry.approvedAt = new Date().toISOString();
                saveData(DB.discord_vehicles, discordVehicles);
                found = true;
                data = entry;
                console.log(`[DISCORD] Zatwierdzono pojazd: ${entry.brand} ${entry.model} [${entry.plate}]`);
            }
        } else if (type === 'insurance') {
            const entry = Object.values(discordInsurance).find(i => i.messageId === id || i.id === id);
            if (entry) {
                entry.approved = true;
                entry.approvedAt = new Date().toISOString();
                saveData(DB.discord_insurance, discordInsurance);
                found = true;
                data = entry;
                console.log(`[DISCORD] Zatwierdzono OC: ${entry.brand} [${entry.plate}]`);
            }
        } else if (type === 'sale') {
            const entry = Object.values(discordVehicleSales).find(s => s.messageId === id || s.id === id);
            if (entry) {
                entry.approved = true;
                entry.approvedAt = new Date().toISOString();
                
                // Usuń pojazd z listy właściciela
                const vehicleToRemove = Object.values(discordVehicles).find(v => 
                    v.brand === entry.brand && 
                    v.model === entry.model && 
                    v.discordId === entry.discordId
                );
                
                if (vehicleToRemove) {
                    delete discordVehicles[vehicleToRemove.id];
                    saveData(DB.discord_vehicles, discordVehicles);
                    console.log(`[DISCORD] Usunięto pojazd po sprzedaży: ${vehicleToRemove.brand} ${vehicleToRemove.model}`);
                }
                
                saveData(DB.discord_vehicle_sales, discordVehicleSales);
                found = true;
                data = entry;
                console.log(`[DISCORD] Zatwierdzono sprzedaż: ${entry.brand} ${entry.model}`);
            }
        }
        
        if (!found) {
            return res.status(404).json({ success: false, message: 'Entry not found' });
        }
        
        res.json({ success: true, data });
        
    } catch (error) {
        console.error('[DISCORD] Błąd zatwierdzania:', error);
        res.status(500).json({ success: false, message: 'Internal server error' });
    }
});

// ----------------------------------------------------------------
// GET /api/discord/info/:discordId - Dane dla komendy !info
// ----------------------------------------------------------------
app.get('/api/discord/info/:discordId', (req, res) => {
    try {
        const { discordId } = req.params;
        
        // Znajdź dowód osobisty (tylko ZATWIERDZONY i OSTATNI)
        const allCitizens = Object.values(discordCitizens)
            .filter(c => c.discordId === discordId && c.approved)
            .sort((a, b) => new Date(b.submittedAt) - new Date(a.submittedAt));
        
        const citizen = allCitizens[0] || null; // Weź najnowszy
        
        // Znajdź wszystkie pojazdy (jako właściciel lub współwłaściciel)
        const vehicles = Object.values(discordVehicles).filter(v => {
            if (!v.approved) return false;
            
            // Sprawdź czy jest głównym właścicielem
            if (v.discordId === discordId) return true;
            
            // Sprawdź czy jest współwłaścicielem
            if (Array.isArray(v.owners) && v.owners.length > 0) {
                return v.owners.some(owner => {
                    if (!owner) return false;
                    
                    const ownerStr = owner.toString().trim();
                    
                    // Format: <@123456789> (Discord mention)
                    if (ownerStr.includes(`<@${discordId}>`)) return true;
                    
                    // Format: 123456789 (samo ID)
                    if (ownerStr === discordId) return true;
                    
                    // Format: User#1234 (Discord tag)
                    if (citizen && ownerStr === citizen.discordTag) return true;
                    
                    // Format: Username (bez #)
                    if (citizen && ownerStr.toLowerCase().includes(citizen.discordTag.split('#')[0].toLowerCase())) return true;
                    
                    return false;
                });
            }
            
            return false;
        });
        
        // Znajdź ubezpieczenia dla pojazdów
        const insurance = Object.values(discordInsurance).filter(i => {
            if (!i.approved) return false;
            
            // Sprawdź czy pojazd należy do użytkownika
            return vehicles.some(v => v.plate === i.plate);
        });
        
        if (!citizen && vehicles.length === 0) {
            return res.status(404).json({ 
                success: false, 
                message: 'Nie znaleziono danych dla tego użytkownika' 
            });
        }
        
        res.json({
            success: true,
            citizen: citizen || null,
            vehicles: vehicles,
            insurance: insurance,
            stats: {
                totalVehicles: vehicles.length,
                insuredVehicles: insurance.length,
                hasValidID: citizen && citizen.approved
            }
        });
        
    } catch (error) {
        console.error('[DISCORD] Błąd pobierania info:', error);
        res.status(500).json({ success: false, message: 'Internal server error' });
    }
});

// ----------------------------------------------------------------
// POST /api/discord/sync - Auto-sync (wywoływany co godzinę)
// ----------------------------------------------------------------
app.post('/api/discord/sync', (req, res) => {
    try {
        // Ta funkcja może być rozszerzona o:
        // - Sprawdzanie wygasłych ubezpieczeń
        // - Czyszczenie starych niezatwierdzonych entry
        // - Synchronizację z bazą citizens
        
        const now = new Date();
        const oneMonthAgo = new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000);
        
        // Usuń niezatwierdzone entry starsze niż 30 dni
        let removedCount = 0;
        
        Object.keys(discordCitizens).forEach(key => {
            const entry = discordCitizens[key];
            if (!entry.approved && new Date(entry.submittedAt) < oneMonthAgo) {
                delete discordCitizens[key];
                removedCount++;
            }
        });
        
        Object.keys(discordVehicles).forEach(key => {
            const entry = discordVehicles[key];
            if (!entry.approved && new Date(entry.submittedAt) < oneMonthAgo) {
                delete discordVehicles[key];
                removedCount++;
            }
        });
        
        Object.keys(discordInsurance).forEach(key => {
            const entry = discordInsurance[key];
            if (!entry.approved && new Date(entry.submittedAt) < oneMonthAgo) {
                delete discordInsurance[key];
                removedCount++;
            }
        });
        
        if (removedCount > 0) {
            saveData(DB.discord_citizens, discordCitizens);
            saveData(DB.discord_vehicles, discordVehicles);
            saveData(DB.discord_insurance, discordInsurance);
        }
        
        console.log(`[DISCORD SYNC] Wykonano synchronizację. Usunięto ${removedCount} starych niezatwierdzonych entry.`);
        
        res.json({ 
            success: true, 
            removedCount,
            stats: {
                citizens: Object.keys(discordCitizens).length,
                vehicles: Object.keys(discordVehicles).length,
                insurance: Object.keys(discordInsurance).length,
                sales: Object.keys(discordVehicleSales).length
            }
        });
        
    } catch (error) {
        console.error('[DISCORD] Błąd synchronizacji:', error);
        res.status(500).json({ success: false, message: 'Internal server error' });
    }
});

// ----------------------------------------------------------------
// POST /api/discord/bulk-import - Bulk import z Discord (komenda !importall)
// ----------------------------------------------------------------
app.post('/api/discord/bulk-import', (req, res) => {
    try {
        const { type, data } = req.body;
        
        if (!type || !Array.isArray(data)) {
            return res.status(400).json({ 
                success: false, 
                message: 'Wymagane: type (string) i data (array)' 
            });
        }
        
        let imported = 0;
        let skipped = 0;
        let errors = 0;
        
        // Importuj dane według typu
        if (type === 'citizens') {
            // Grupuj po discordId
            const citizensByUser = {};
            data.forEach(citizen => {
                const uid = citizen.discordId;
                if (!citizensByUser[uid]) {
                    citizensByUser[uid] = [];
                }
                citizensByUser[uid].push(citizen);
            });
            
            // Dla każdego użytkownika - weź tylko ostatni dowód
            Object.keys(citizensByUser).forEach(uid => {
                const userCitizens = citizensByUser[uid].sort((a, b) => 
                    new Date(b.submittedAt) - new Date(a.submittedAt)
                );
                
                // Tylko najnowszy
                const latestCitizen = userCitizens[0];
                
                // Sprawdź czy już istnieje
                const exists = Object.values(discordCitizens).some(c => 
                    c.messageId === latestCitizen.messageId
                );
                
                if (!exists) {
                    const citizenId = latestCitizen.id || `CITIZEN_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    discordCitizens[citizenId] = latestCitizen;
                    imported++;
                } else {
                    skipped++;
                }
            });
            
            if (imported > 0) {
                saveData(DB.discord_citizens, discordCitizens);
            }
            
        } else if (type === 'vehicles') {
            data.forEach(vehicle => {
                const exists = Object.values(discordVehicles).some(v => 
                    v.messageId === vehicle.messageId
                );
                
                if (!exists) {
                    const vehicleId = vehicle.id || `VEH_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    discordVehicles[vehicleId] = vehicle;
                    imported++;
                } else {
                    skipped++;
                }
            });
            
            if (imported > 0) {
                saveData(DB.discord_vehicles, discordVehicles);
            }
            
        } else if (type === 'insurance') {
            data.forEach(insurance => {
                const exists = Object.values(discordInsurance).some(i => 
                    i.messageId === insurance.messageId
                );
                
                if (!exists) {
                    const insuranceId = insurance.id || `INS_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    discordInsurance[insuranceId] = insurance;
                    imported++;
                } else {
                    skipped++;
                }
            });
            
            if (imported > 0) {
                saveData(DB.discord_insurance, discordInsurance);
            }
            
        } else if (type === 'sales') {
            data.forEach(sale => {
                const exists = Object.values(discordVehicleSales).some(s => 
                    s.messageId === sale.messageId
                );
                
                if (!exists) {
                    const saleId = sale.id || `SALE_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
                    discordVehicleSales[saleId] = sale;
                    imported++;
                } else {
                    skipped++;
                }
            });
            
            if (imported > 0) {
                saveData(DB.discord_vehicle_sales, discordVehicleSales);
            }
            
        } else {
            return res.status(400).json({ 
                success: false, 
                message: `Nieznany typ: ${type}. Dozwolone: citizens, vehicles, insurance, sales` 
            });
        }
        
        console.log(`[BULK IMPORT] ${type}: zaimportowano ${imported}, pominięto ${skipped}, błędy ${errors}`);
        
        res.json({ 
            success: true, 
            type,
            imported,
            skipped,
            errors,
            total: data.length
        });
        
    } catch (error) {
        console.error('[BULK IMPORT] Błąd:', error);
        res.status(500).json({ success: false, message: 'Internal server error' });
    }
});


