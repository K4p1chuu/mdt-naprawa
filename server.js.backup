// ENDPOINT: Rejestracja nowych funkcjonariuszy
app.post('/api/register', verifyToken, verifyAdmin, (req, res) => {
    const { email, username, password, badge, rank, department, isAdmin, robloxId, discordNick, robloxNick, joinedAt } = req.body;
    
    if (!email || !username || !password || !badge || !rank || !department) {
        return res.status(400).json({ success: false, message: 'Wszystkie pola są wymagane' });
    }
    
    if (users[email]) {
        return res.status(400).json({ success: false, message: 'Użytkownik o tym emailu już istnieje' });
    }
    
    const newUser = {
        id: crypto.randomUUID(),
        email,
        username,
        password,
        badge,
        rank,
        department,
        isAdmin: isAdmin || false,
        robloxId: robloxId || '',
        discordNick: discordNick || '',
        robloxNick: robloxNick || '',
        joinedAt: joinedAt || new Date().toISOString(),
        token: null
    };
    
    users[email] = newUser;
    saveData(DB.users, users);
    
    res.json({ success: true, user: newUser });
});

// ENDPOINT: Pobieranie dywizji
app.get('/api/divisions', verifyToken, (req, res) => {
    res.json(divisions);
});

// ENDPOINT: Dodawanie członków do dywizji
app.post('/api/divisions/members', verifyToken, verifyAdmin, (req, res) => {
    const { department, divisionName, memberType, officerName } = req.body;
    
    if (!divisions[department]) {
        divisions[department] = {};
    }
    
    if (!divisions[department][divisionName]) {
        divisions[department][divisionName] = {
            lead: [],
            members: []
        };
    }
    
    if (memberType === 'lead') {
        if (!divisions[department][divisionName].lead.includes(officerName)) {
            divisions[department][divisionName].lead.push(officerName);
        }
    } else if (memberType === 'members') {
        if (!divisions[department][divisionName].members.includes(officerName)) {
            divisions[department][divisionName].members.push(officerName);
        }
    }
    
    saveData(DB.divisions, divisions);
    res.json({ success: true });
});

// ENDPOINT: Usuwanie członków z dywizji
app.delete('/api/divisions/members', verifyToken, verifyAdmin, (req, res) => {
    const { department, divisionName, memberType, officerName } = req.body;
    
    if (!divisions[department] || !divisions[department][divisionName]) {
        return res.status(404).json({ success: false, message: 'Nie znaleziono dywizji' });
    }
    
    if (memberType === 'lead') {
        divisions[department][divisionName].lead = divisions[department][divisionName].lead.filter(name => name !== officerName);
    } else if (memberType === 'members') {
        divisions[department][divisionName].members = divisions[department][divisionName].members.filter(name => name !== officerName);
    }
    
    saveData(DB.divisions, divisions);
    res.json({ success: true });
});

